# ROCm image for nerfstudio-rocm. Defaults to the public rocm/pytorch image at
# the exact ROCm/torch versions pinned in dependencies/rocm-lock.toml. If you
# have pull access to the splatograph project's private snapshot (faster,
# pre-warmed with extra deps), override at build time with:
#   --build-arg BASE_ROCM_PYTHON=ghcr.io/bjoernellens1/splatograph:rocm-python-base-snapshot
ARG BASE_ROCM_PYTHON=docker.io/rocm/pytorch:rocm7.2.2_ubuntu24.04_py3.12_pytorch_release_2.10.0
FROM ${BASE_ROCM_PYTHON}

# gfx1151 = Strix Halo / Radeon 8060S (this project's primary dev target).
# Override at build time for other targets, e.g. --build-arg PYTORCH_ROCM_ARCH=gfx942
ARG PYTORCH_ROCM_ARCH=gfx1151
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH} \
    HSA_XNACK=1 \
    HSA_ENABLE_SDMA=0 \
    CUDA_HOME=/opt/rocm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# --- gsplat: verified ROCm fork, pinned commit in dependencies/rocm-lock.toml ---
# Hard dependency — builds under plain `docker build` with no GPU device access
# required, because setup.py reads PYTORCH_ROCM_ARCH (gsplat#2, fixed) rather
# than shelling out to rocminfo. See scripts/install-rocm-deps.sh for the
# equivalent runtime/manual install path used during development/debugging.
RUN git clone --branch release/1.5.3b2 https://github.com/bjoernellens1/gsplat.git && \
    cd gsplat && git submodule update --init --recursive && \
    CUDA_HOME=/opt/rocm python -m pip install --no-cache-dir --no-build-isolation .

# --- nerfacc: ROCm fork verified on gfx1151 (own test suite + Instant-NGP training run) ---
RUN git clone --branch release/0.5.3 https://github.com/bjoernellens1/nerfacc-rocm.git nerfacc && \
    cd nerfacc && \
    CUDA_HOME=/opt/rocm python -m pip install --no-cache-dir --no-build-isolation --no-deps .

# --- tiny-rocm-nn: verified on gfx1151 (wave32 numerical correctness + Instant-NGP
# training run with tcnn genuinely active, see ROCM.md "tiny-rocm-nn: what's actually
# there") — hard dependency, same pattern as gsplat/nerfacc.
# NOTE: --recursive is required — tiny-rocm-nn vendors `dependencies/fmt` as a git
# submodule that a plain clone does not populate, and the build fails on a missing
# format.cc without it.
RUN git clone --recursive --branch rocm-gfx1151-validation https://github.com/bjoernellens1/tiny-rocm-nn.git && \
    cd tiny-rocm-nn/bindings/torch && \
    python -m pip install --no-cache-dir --no-build-isolation .

# --- nerfstudio itself --- (build isolation needed: some deps' sdists pull
# in their own build backend, e.g. scikit-build-core, that isn't preinstalled)
COPY . /workspace/nerfstudio-rocm
WORKDIR /workspace/nerfstudio-rocm
# nerfstudio's pyproject.toml pins Pillow open-ended (">=10.3.0"). Pillow >=12
# broke nerfstudio/data/utils/data_utils.py's pil_to_numpy(), which calls
# PIL.Image._getencoder(...).setimage() directly (a private API whose arity
# changed) — unrelated to ROCm, reproduces on any platform. Pin down until
# fixed upstream. See ROCM.md "Known build issues".
RUN python -m pip install --no-cache-dir -e . && \
    python -m pip install --no-cache-dir "Pillow<12"

CMD ["bash"]
